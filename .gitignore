*.dll
*.pdb
*.exe

# Proprietary fonts are served from .local/ by the preview only.
/app/assets/private-fonts/
PP*.ttf
PP*.otf
PP*.woff
PP*.woff2

# Built TV packages belong in dist/ or a release, not in Git.
*.wgt
*.ipk

# Personal studies, research and draft writing stay local.
/explorations/
/docs/research/
/docs/articles/
