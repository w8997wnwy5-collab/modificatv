{
  "name": "cleanframe-lg",
  "version": "0.6.1",
  "private": true,
  "description": "CleanFrame, a quiet home screen, adapted for LG webOS TVs.",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "dev:public": "python3 scripts/preview.py --public-fonts",
    "check": "npm run lint && python3 scripts/check.py && npm run check:device",
    "lint": "eslint app service",
    "check:device": "node --test scripts/test-device.mjs scripts/test-service.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:public": "python3 scripts/check-public.py",
    "check:performance": "node scripts/check-performance.mjs",
    "package": "python3 scripts/package.py",
    "tv:install": "node scripts/tv.mjs install",
    "tv:launch": "node scripts/tv.mjs launch",
    "tv:remove": "node scripts/tv.mjs remove"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "eslint": "10.13.0",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
